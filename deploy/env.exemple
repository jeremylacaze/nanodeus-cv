# Modèle du .env de production : /opt/nanodeus-cv/.env (chmod 600, compte deploy).
# Les secrets naissent sur le serveur (openssl rand -hex 32) et n'en sortent
# jamais : ni commit, ni rapport, ni terminal. Toutes les valeurs ci-dessous sont
# factices.

# Image en ligne. Seul deploy.sh réécrit cette ligne ; jamais `latest`.
CV_IMAGE=ghcr.io/jeremylacaze/nanodeus-cv:0000000000000000000000000000000000000000

# Mode production : refuse de démarrer avec les secrets de développement.
CV_PROD=1
# Signe les sessions de l'admin.
SECRET_KEY=a-generer-sur-le-serveur
# Sel des empreintes de visite (HMAC) : jamais d'IP en clair dans la base.
CV_SEL_HMAC=a-generer-sur-le-serveur
# Adresse canonique du site (og:url, QR codes).
CV_URL_PUBLIQUE=https://cv.nanodeus.com

# Admin : publiée sur l'interface Tailscale seulement, jamais sur Internet.
CV_ADMIN_ECOUTE=<ip-tailnet>:8780
# Noms d'hôte admis par l'admin (contre le DNS rebinding), séparés par des virgules,
# sans port. Un nom absent (le nom MagicDNS, par exemple) reçoit « Requête refusée ».
CV_ADMIN_HOTES=<ip-tailnet>,<nom-magicdns>
# Réseaux sources admis par l'admin (CIDR, séparés par des virgules). Commentée :
# le défaut, réseaux Tailscale et boucle locale, suffit.
# CV_ADMIN_RESEAUX=100.64.0.0/10,fd7a:115c:a1e0::/48,127.0.0.0/8,::1/128

# Envoi des demandes de contact.
CV_SMTP_HOTE=smtp.exemple.invalid
# 2525 : le netcup bloque en sortie les ports SMTP 587 et 465.
CV_SMTP_PORT=2525
CV_SMTP_UTILISATEUR=utilisateur
CV_SMTP_MOT_DE_PASSE=a-poser-sur-le-serveur
# starttls, ssl ou aucun.
CV_SMTP_TLS=starttls
CV_EMAIL_EXPEDITEUR=cv@nanodeus.com
# Boîte qui reçoit les demandes : jamais affichée sur le site.
CV_EMAIL_DESTINATAIRE=<boîte perso>
